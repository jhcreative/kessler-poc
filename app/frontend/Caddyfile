# Local and box alike. On the box, the shared edge Caddy terminates TLS and proxies here (POC-11, risk R1).
{
	admin off
	# Behind the box's shared edge (Tailor HOST-02), only the edge, at its fixed address, may name the visitor; any
	# other peer is the client itself. Locally nothing extra is trusted. Without this, every visitor would look like the
	# edge, and the per-address login limit would become one bucket for everyone (Tailor behind-edge.py, H-1).
	servers {
		trusted_proxies static {$TRUSTED_PROXY:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		# Orly: a demo of a real client's process with synthetic data. Never indexed, never framed.
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# One entry, the visitor: from a trusted edge Caddy would otherwise append the edge.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		@assets path /assets/* /fonts/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
